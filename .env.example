# MODE options:
#   mock    — all responses are local, no network calls (safe offline demo)
#   sandbox — calls api.shipengine.com/v1 with TEST_ key (real API, no charges)
#   live    — calls api.shipengine.com/v1 with production key (real labels, real money)

SHIPENGINE_API_KEY=TEST_your_sandbox_key_here
MODE=sandbox
PORT=3001
